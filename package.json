{
  "name": "wms",
  "version": "1.0.0",
  "description": "Warehouse Management System - control warehouse operations",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "NODE_ENV=production node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "backup": "node scripts/backup.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "bash tests/run.sh",
    "test:smoke": "node tests/smoke/playwright_smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.4.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^1.7.1",
    "playwright": "^1.48.0"
  }
}
