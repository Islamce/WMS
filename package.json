{
  "name": "wms",
  "version": "1.0.0",
  "description": "Warehouse Management System - control warehouse operations",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "NODE_ENV=production node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "backup": "node scripts/backup.js",
    "verify-backup": "node scripts/verify-backup.js",
    "validate-opening-stock": "node scripts/validate-opening-stock.js",
    "reset-admin": "node scripts/reset-admin.js",
    "fresh-start": "node scripts/fresh-start.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "bash tests/run.sh",
    "test:smoke": "node tests/smoke/playwright_smoke.js && node tests/smoke/request_line_visibility_browser.js && node tests/smoke/design_foundation_browser.js",
    "test:load": "node tests/load/smoke-load.js"
  },
  "engines": {
    "node": "20.x"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "11.10.0",
    "chart.js": "^4.4.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^1.7.1",
    "playwright": "^1.48.0"
  }
}
