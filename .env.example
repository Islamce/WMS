# Copy to .env and adjust as needed.
# In production set these as real environment variables in your host's panel.

# The port your app listens on. Managed Node.js hosting (Hostinger hPanel,
# cPanel Passenger) injects PORT automatically — leave it to them there.
PORT=3000

# Runtime mode. Set to "production" when deploying — it turns on the strict
# JWT_SECRET check below and disables dev conveniences.
NODE_ENV=development

# REQUIRED in production: a long random secret (>= 32 chars, not this
# placeholder). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid.
JWT_EXPIRES_IN=8h

# SQLite database file. Keep it on persistent, writable storage. On a VPS a
# path outside the app dir (e.g. /var/lib/wms/wms.db) survives redeploys. On a
# container platform, mount a persistent volume at this location AND at
# data/attachments — otherwise a redeploy loses the database and uploaded files.
DB_PATH=./data/wms.db

# Safety guard: in production the app will NOT auto-seed an empty database
# (which would write demo data over a missing volume) unless you set this to 1
# for a genuine first deployment. Leave unset after the first run.
# ALLOW_AUTO_SEED=1

# Per-request API logging to stdout (method, status, ms, path, user). Set to 0
# to silence.
LOG_REQUESTS=1

# Automated backups: set a writable directory to enable an in-process daily
# SQLite backup (also run manually with `npm run backup`). Kept for
# BACKUP_RETENTION_DAYS days (default 14).
# BACKUP_DIR=/var/backups/wms
# BACKUP_RETENTION_DAYS=14

# Release stock reservations for requests that sit unpicked this many hours
# (default 24). The scheduler returns the stock to available and puts the
# request On Hold.
RESERVATION_TTL_HOURS=24

# Background scheduler (picking reminders/escalation + reservation timeout).
# On by default. When several app processes run (PM2 cluster, overlapping
# deploy) a per-job DB lease ensures only ONE runs each tick, so leaving it on
# everywhere is safe. Set to 0 on processes that should never run it (e.g. if a
# dedicated worker owns background jobs).
SCHEDULER_ENABLED=1

# Global API rate limit: max requests per client IP per window across the whole
# API (complements the stricter per-email login limiter). Set API_RATE_LIMIT=0
# to disable. Defaults: 2000 requests / 60000 ms.
API_RATE_LIMIT=2000
API_RATE_WINDOW_MS=60000

# Email notifications. Off by default (in-app inbox only). Set
# EMAIL_NOTIFICATIONS=1 to also email key events; configure a transport with
# SMTP_URL (smtp://user:pass@host:port) or SMTP_HOST/SMTP_PORT/SMTP_USER/
# SMTP_PASS/SMTP_SECURE, and EMAIL_FROM. Requires the optional `nodemailer`
# package; without it (or without SMTP) emails are logged, not sent.
# EMAIL_NOTIFICATIONS=1
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=wms@example.com

# Data retention (P3/O-3): prune notification_log and erp_integration_log rows
# older than this many days on the daily sweep. 0 disables pruning. The audit
# trail is never pruned (append-only, permanent).
RETENTION_DAYS=0
