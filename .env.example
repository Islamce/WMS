# Copy to .env and adjust as needed.
# In production set these as real environment variables in your host's panel.

# The port your app listens on. Managed Node.js hosting (Hostinger hPanel,
# cPanel Passenger) injects PORT automatically — leave it to them there.
PORT=3000

# Runtime mode. Set to "production" when deploying — it turns on the strict
# JWT_SECRET check below and disables dev conveniences.
NODE_ENV=development

# REQUIRED in production: a long random secret (>= 32 chars, not this
# placeholder). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid.
JWT_EXPIRES_IN=8h

# SQLite database file. Keep it on persistent, writable storage. On a VPS a
# path outside the app dir (e.g. /var/lib/wms/wms.db) survives redeploys.
DB_PATH=./data/wms.db

# Per-request API logging to stdout (method, status, ms, path, user). Set to 0
# to silence.
LOG_REQUESTS=1

# Automated backups: set a writable directory to enable an in-process daily
# SQLite backup (also run manually with `npm run backup`). Kept for
# BACKUP_RETENTION_DAYS days (default 14).
# BACKUP_DIR=/var/backups/wms
# BACKUP_RETENTION_DAYS=14

# Release stock reservations for requests that sit unpicked this many hours
# (default 24). The scheduler returns the stock to available and puts the
# request On Hold.
RESERVATION_TTL_HOURS=24
