node_modules/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
.env
npm-debug.log*

# Provisioned tenants: each directory holds a customer's live SQLite database
# and its own JWT secret (.env). Never committed — one leaked secret here lets a
# token forged for that tenant authenticate against it.
tenants/

# Python bytecode. Never committed: a hash-based .pyc executes without Python
# ever reading the .py beside it, and nobody reads bytecode in a review.
__pycache__/
*.pyc

# Scratch probe/diagnostic scripts. Never committed: they take a database path
# and have none of the guards the reviewed scripts in scripts/ carry.
.probe-*
